# Copy to .env and fill in. Never commit .env.

# --- Core ---
JOBBOT_ENV=dev
JOBBOT_DATABASE_URL=sqlite:///var/jobbot.db
JOBBOT_LOG_LEVEL=INFO

# --- Applicant identity (used in outreach) ---
JOBBOT_APPLICANT_NAME=
JOBBOT_APPLICANT_EMAIL=
JOBBOT_APPLICANT_PHONE=
JOBBOT_APPLICANT_LINKEDIN=
JOBBOT_APPLICANT_GITHUB=

# --- Rate limits & safety caps (see docs/safety.md) ---
# Hard ceiling on outreach sent per calendar day.
JOBBOT_MAX_APPLICATIONS_PER_DAY=20
# Minimum days before the same company may be contacted again.
JOBBOT_COMPANY_COOLDOWN_DAYS=30
# Requests per second against a single external domain.
JOBBOT_DOMAIN_RATE_LIMIT=0.5
# Honour robots.txt on every non-API fetch. Do not disable.
JOBBOT_RESPECT_ROBOTS=true

# --- Matching ---
# Jobs scoring below this never reach the contact-resolution arm.
JOBBOT_MIN_MATCH_SCORE=55
# Applications scoring below this always require manual review (they already do,
# but this flags them as low-confidence in the queue).
JOBBOT_REVIEW_CONFIDENCE_THRESHOLD=70

# --- Orchestration (jobbot run --due-only) ---
# How often each arm should run. An external scheduler fires
# `jobbot run --due-only` on a short fixed interval and these decide what is
# actually due, so the scheduler entry never changes when you adjust one.
# Arm 0 is weekly: company directories change over months, so polling them daily
# spends requests to learn nothing.
JOBBOT_ARM0_INTERVAL_HOURS=168
JOBBOT_ARM1_INTERVAL_HOURS=24
JOBBOT_ARM2_INTERVAL_HOURS=24
JOBBOT_ARM3_INTERVAL_HOURS=24

# Per-run batch budgets. Arm 3's is small on purpose: drafting runs a local model
# at roughly a minute per application, so a larger number occupies the GPU for an
# hour to produce more cards than anyone reads.
JOBBOT_ARM2_BATCH_SIZE=25
JOBBOT_ARM3_BATCH_SIZE=5

# How long a lock file may sit before a later run treats it as abandoned. This is
# age-based rather than a check on whether the recorded process is alive, because
# pid liveness is not portable to Windows.
JOBBOT_MAX_RUN_HOURS=6

# --- LLM (arm 3 content generation ONLY; scoring is rule-based and free) ---
ANTHROPIC_API_KEY=
# claude-opus-5 ($5/$25 per Mtok) is the default. claude-sonnet-5 ($3/$15,
# intro $2/$10 through 2026-08-31) is the cheaper option for this task.
JOBBOT_LLM_MODEL=claude-opus-5
JOBBOT_LLM_MONTHLY_BUDGET_USD=25
# Cover letters are written into a queue a human reads later, so nothing here is
# latency-sensitive. The Batch API costs 50% less for exactly that trade.
JOBBOT_LLM_USE_BATCH=true

# --- Email sending (arm 3) ---
# "smtp" (default) or "outlook".
JOBBOT_MAIL_PROVIDER=smtp

# SMTP with an app password. An app password is revocable on its own and is
# NOT the account password, but it does grant POP/IMAP/SMTP - broader than the
# Mail.Send OAuth scope below.
#
# Gmail:    https://myaccount.google.com/apppasswords (needs 2-Step Verification)
#           host smtp.gmail.com, port 587
# Outlook:  password sign-in is being disabled for personal accounts; a refusal
#           reading "5.7.139 basic authentication is disabled" means no app
#           password will ever work - use JOBBOT_MAIL_PROVIDER=outlook instead.
JOBBOT_SMTP_HOST=smtp.gmail.com
JOBBOT_SMTP_PORT=587
JOBBOT_SMTP_USERNAME=
JOBBOT_SMTP_PASSWORD=

# Where replies should land. Providers force the From header to the
# authenticated account, so this is how answers reach the address on your CV.
# Defaults to JOBBOT_APPLICANT_EMAIL when left blank.
JOBBOT_REPLY_TO_EMAIL=

# Alternative: Microsoft Graph, Mail.Send scope only - the token can send and
# canNOT read the mailbox. Needs an Entra app registration, which personal
# Microsoft accounts often cannot create (portal.azure.com, not entra):
#   App registrations -> New registration -> "Personal Microsoft accounts only"
#   -> Authentication -> Allow public client flows: Yes
#   -> copy the Application (client) ID, then run: jobbot mail login
JOBBOT_MS_CLIENT_ID=
JOBBOT_MS_TOKEN_PATH=var/ms_token.json

# Pacing between sends, in seconds. Randomised within this range: a fixed
# interval is a stronger bulk-sender signal than volume is.
JOBBOT_SEND_MIN_GAP_SECONDS=90
JOBBOT_SEND_MAX_GAP_SECONDS=420

# --- Optional job board APIs ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
